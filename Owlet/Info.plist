<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Run as a UI agent: no Dock icon, no menu bar app menu, no main window.
	     This is the key that turns Owlet into a pure menu-bar (status bar) app. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Minimum supported OS. Requirement: macOS 13+. -->
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>

	<!-- We do not ship a main storyboard/nib; the UI is built programmatically. -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<key>NSHumanReadableCopyright</key>
	<string></string>

	<!-- ===== Sparkle auto-update ===== -->

	<!-- The appcast feed. Owlet publishes appcast.xml to its GitHub Releases, so
	     this stable URL always points at the newest published feed. -->
	<key>SUFeedURL</key>
	<string>https://github.com/LushBinary/Owlet/releases/latest/download/appcast.xml</string>

	<!-- EdDSA (ed25519) PUBLIC key used to verify update signatures. This is NOT
	     an Apple key and needs no Apple account. It's the public half of the key
	     pair generated by Sparkle's `generate_keys`; the matching private key is
	     stored in the login keychain and, for CI, the SPARKLE_PRIVATE_KEY secret.
	     Safe to commit. -->
	<key>SUPublicEDKey</key>
	<string>aOFKpXXyW6mFiOjkKYEeh6NjwmhjzQNZrfOYHpos6V8=</string>

	<!-- Check for updates automatically (the user is asked for consent on first
	     launch) and no more than once a day. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
